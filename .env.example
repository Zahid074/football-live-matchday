# Neon Postgres connection string (from your Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# football-data.org API
FOOTBALL_API_KEY=b405a73a7df1497da4495cf1269a49ca
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4

# Google OAuth (from Google Cloud Console -> Credentials -> OAuth Client ID -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail sender (dedicated Gmail account + App Password, NOT your normal password)
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=

# Random long random string for signing login sessions
JWT_SECRET=change-this-to-a-long-random-string

# Your deployed frontend URL (used for CORS). During local dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Port the backend listens on (Render/Railway set this automatically, keep as fallback)
PORT=4000
